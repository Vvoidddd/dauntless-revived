# Copy to .env and fill in. `npm start` and `npm run verify` read it.

# Port, and the addresses to listen on (comma-separated). Only loopback and Tailscale addresses
# (100.64.0.0/10) are accepted: for friends, add this PC's 100.x address, e.g. 127.0.0.1,100.101.102.103
PORT=61002
BIND_HOST=127.0.0.1

# The metagame, used to check account keys (GET /undaunted/api/GetUserInfo)
METAGAME_URL=http://127.0.0.1:61000

# The verified 1.4.4 install: the folder that contains Archon\ (read-only; never modified)
CONTENT_GAME_DIR=

# Optional: the host's art pack (jpg/png/webp plus an optional branding.json) and news file
CONTENT_BRANDING_DIR=
CONTENT_NEWS_FILE=

# Optional limits (defaults shown)
CONTENT_MAX_STREAMS_PER_ACCOUNT=6
CONTENT_MAX_STREAMS_TOTAL=48
CONTENT_AUTH_CACHE_SECONDS=300

# Optional: a different manifest than data/dauntless-1.4.4.json
CONTENT_MANIFEST=

# Only if a firewall keeps the internet out: allow BIND_HOST values other than loopback/Tailscale
CONTENT_ALLOW_ANY_BIND=
