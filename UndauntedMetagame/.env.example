PORT=
AUTH_MODE=
AUTH_SIGNING_PRIVKEY_B64=
AUTH_SIGNING_PUBKEY_B64=
DB_FILENAME=
TARGET_CHANGELIST=
QOS_TARGET_URL=
MATCHMAKING_MODE=
DEPLOYSERVER_URL=
REGISTRATION_MODE=

# Optional, fork only. Leave a line out to get the default; docs/setup/host.md explains each one.

# Progression. Unset or empty (the default) or "real": every account keeps its own Slayer level,
# mastery, Hunt Pass (Elite for everyone), loadout slots, cooldowns and bounties. "stub": upstream's
# fake max ranks, nothing stored. Any other value (off, 0, false...) is logged and treated as real;
# it used to mean stub. Updating a server that already has players? Read
# docs/setup/upgrading.md first: nothing is migrated, and earlier players start at Slayer level 1.
# PROGRESSION_MODE=stub
# Only with PROGRESSION_MODE=stub: comma-separated account ids that get real progression anyway.
# PROGRESSION_REAL_ACCOUNTS=UID-...,UID-...

# Off by default on purpose (docs/setup/host.md says why): refuse inventory overspends, WAL journal,
# capture request bodies of unfinished save routes.
# INVENTORY_REFUSE_OVERSPEND=1
# DB_WAL=1
# LOG_BODIES=1
# BODY_LOG_FILE=bodies.log
