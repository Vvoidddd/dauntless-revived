# Dauntless Revived gateway: two processes, each started with its own env file on the server:
#   node --env-file=<gateway.env>   dist\server.js             (the public TLS gateway)
#   node --env-file=<allowlist.env> dist\allowlist\server.js   (the allowlist helper, elevated)
# `npm start` / `npm run start:allowlist` read .env in this folder instead.
# Secrets: 64 hex characters each, for example from
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a filled-in copy of this file.

# ---------------------------------------------------------------- gateway (dist\server.js)
# The only public TCP listener. 0.0.0.0 is IPv4 only, on purpose: the address the gateway reports
# to the allowlist must be the one the game's UDP traffic comes from (MY_IP is IPv4).
GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=443
# PEM files made by `node tools/make-cert.js --host <public IP> --out <dir>`.
GATEWAY_CERT=C:\DauntlessServer\tls\gateway-cert.pem
GATEWAY_KEY=C:\DauntlessServer\tls\gateway-key.pem
# Sent to the metagame as X-Dauntless-Gateway; the metagame's GATEWAY_SECRET must be the same.
GATEWAY_SECRET=
# Upstreams: http:// on this machine only.
GATEWAY_METAGAME_URL=http://127.0.0.1:61000
GATEWAY_CONTENT_URL=http://127.0.0.1:61002
GATEWAY_WS_URL=http://127.0.0.1:61099
# The allowlist helper. Required: without it no player's game ports open.
# (GATEWAY_ALLOWLIST=0 runs without the feed.)
ALLOWLIST_URL=http://127.0.0.1:61005
ALLOWLIST_SECRET=
# An address the helper accepted is re-sent at most this often (seconds, 5-540).
# GATEWAY_ALLOWLIST_REFRESH_SECONDS=60

# Limits (defaults shown; README.md explains how they were sized).
# GATEWAY_MAX_BODY_BYTES=131072
# GATEWAY_MAX_CONNECTIONS=2048
# GATEWAY_MAX_CONNECTIONS_PER_IP=128
# Rate limits per IPv4 address (or IPv6 /64): "<burst>,<per minute>".
# GATEWAY_RATE_GENERAL=300,180
# GATEWAY_RATE_CONTENT=600,600
# GATEWAY_RATE_REGISTER=5,0.2
# GATEWAY_RATE_TOKEN=10,1
# GATEWAY_RATE_CONNECT=200,300
# Timeouts in milliseconds.
# GATEWAY_HANDSHAKE_TIMEOUT_MS=10000
# GATEWAY_HEADERS_TIMEOUT_MS=10000
# GATEWAY_REQUEST_TIMEOUT_MS=30000
# GATEWAY_KEEPALIVE_TIMEOUT_MS=65000
# GATEWAY_IDLE_TIMEOUT_MS=120000
# GATEWAY_UPSTREAM_IDLE_TIMEOUT_MS=120000
# GATEWAY_WS_IDLE_TIMEOUT_MS=300000
# GATEWAY_SHUTDOWN_GRACE_MS=10000

# ---------------------------------------------------------------- allowlist helper (dist\allowlist\server.js)
# Required, no default: 1 only writes what it would do to the audit log (use it on any machine
# that is not the server), 0 really changes Windows Firewall (needs administrator rights).
ALLOWLIST_DRY_RUN=1
# Loopback only (127.0.0.1 or ::1).
ALLOWLIST_BIND=127.0.0.1
ALLOWLIST_PORT=61005
# ALLOWLIST_SECRET= (the same value as above; one env file per process on the server)
# The game servers' UDP ports.
ALLOWLIST_PORTS=8770-8777
# How long an address stays open after its last heartbeat or login.
ALLOWLIST_TTL_SECONDS=600
# Firewall rule changes happen at most this often.
# ALLOWLIST_MIN_INTERVAL_MS=3000
# ALLOWLIST_MAX_ENTRIES=256
ALLOWLIST_AUDIT_LOG=C:\DauntlessServer\data\allowlist\audit.log
ALLOWLIST_STATE_FILE=C:\DauntlessServer\data\allowlist\state.json
# Tests and LAN only: also accept private, loopback and link-local addresses.
# ALLOWLIST_ALLOW_PRIVATE=1

# LOG_LEVEL=info
